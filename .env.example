# Application
# Lowercase deployment identifier used only for logs and diagnostics.
# Use a distinct value in every Portainer stack.
INSTANCE_NAME=local
# Compose image tag; production should use the approved immutable release tag.
IMAGE_TAG=develop
TZ=Europe/Vienna
DATABASE_PATH=/data/sports.db
LOG_LEVEL=INFO
HEARTBEAT_INTERVAL=300

# Microsoft 365 application
M365_TENANT_ID=your-tenant-id
M365_CLIENT_ID=your-client-id
M365_CLIENT_SECRET=your-client-secret
M365_USER_ID=your-mailbox@example.com

# Outlook calendar
# OUTLOOK_CALENDAR_ID is the required immutable Graph calendar identifier used
# for every synchronization write. OUTLOOK_CALENDAR_NAME is used by the
# optional startup reachability check and must identify the same calendar.
OUTLOOK_CALENDAR_NAME=SMART Sports Calendar
OUTLOOK_CALENDAR_ID=your-outlook-calendar-id
SYNCHRONIZATION_BATCH_LIMIT=100

# Microsoft Graph
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Validate Microsoft Graph authentication and calendar access during startup
# Keep enabled for normal deployments; disable only for isolated CI validation
GRAPH_STARTUP_VALIDATION_ENABLED=true

# Provider-neutral source jobs. Keep empty until the referenced adapter is
# enabled. Every active competition/season scope requires exactly one
# authoritative job. JSON must remain on one line.
SOURCE_JOBS_JSON=[]
# Legacy API-Football example for explicit orchestration:
# SOURCE_JOBS_JSON=[{"job_key":"api-football-premier-league","source_key":"api_football","sport_key":"football","competition_key":"premier_league","season_key":"2026_27","role":"authoritative","interval_seconds":3600}]
# v0.4.5-beta.1 Premier League authority:
# SOURCE_JOBS_JSON=[{"job_key":"football-data-premier-league","source_key":"football_data","sport_key":"football","competition_key":"premier_league","season_key":"2026_27","role":"authoritative","interval_seconds":3600}]
# Phase 5 Premier League and Bundesliga authorities with six-hour polling:
# SOURCE_JOBS_JSON=[{"job_key":"football-data-premier-league","source_key":"football_data","sport_key":"football","competition_key":"premier_league","season_key":"2026_27","role":"authoritative","interval_seconds":21600},{"job_key":"football-data-bundesliga","source_key":"football_data","sport_key":"football","competition_key":"bundesliga","season_key":"2026_27","role":"authoritative","interval_seconds":21600}]
# Phase 5 DFB-Pokal OpenLigaDB authority with six-hour polling:
# SOURCE_JOBS_JSON=[{"job_key":"openligadb-dfb-pokal","source_key":"openligadb","sport_key":"football","competition_key":"dfb_pokal","season_key":"2026_27","role":"authoritative","interval_seconds":21600}]
# Phase 5 staging candidate: Premier League, Bundesliga, and DFB-Pokal:
# SOURCE_JOBS_JSON=[{"job_key":"football-data-premier-league","source_key":"football_data","sport_key":"football","competition_key":"premier_league","season_key":"2026_27","role":"authoritative","interval_seconds":21600},{"job_key":"football-data-bundesliga","source_key":"football_data","sport_key":"football","competition_key":"bundesliga","season_key":"2026_27","role":"authoritative","interval_seconds":21600},{"job_key":"openligadb-dfb-pokal","source_key":"openligadb","sport_key":"football","competition_key":"dfb_pokal","season_key":"2026_27","role":"authoritative","interval_seconds":21600}]

# football-data.org API v4 Premier League and Bundesliga authority
# All configured competition jobs share this provider-wide quota configuration.
# Keep the token only in Portainer or another ignored operator secret store.
FOOTBALL_DATA_ENABLED=false
FOOTBALL_DATA_API_KEY=your-football-data-token
FOOTBALL_DATA_BASE_URL=https://api.football-data.org
FOOTBALL_DATA_CONNECT_TIMEOUT_SECONDS=5
FOOTBALL_DATA_READ_TIMEOUT_SECONDS=30
FOOTBALL_DATA_MAX_ATTEMPTS=3
FOOTBALL_DATA_RETRY_BASE_DELAY_SECONDS=1
FOOTBALL_DATA_RETRY_MAX_DELAY_SECONDS=30
FOOTBALL_DATA_REQUESTS_PER_MINUTE=10
FOOTBALL_DATA_MINIMUM_REQUEST_INTERVAL_SECONDS=6.1

# Public OpenLigaDB API v1 DFB-Pokal authority
# No account or API credential is required. Every observation remains partial
# and can create or update fixtures but can never infer cancellation/removal.
OPENLIGADB_ENABLED=false
OPENLIGADB_BASE_URL=https://api.openligadb.de
OPENLIGADB_CONNECT_TIMEOUT_SECONDS=5
OPENLIGADB_READ_TIMEOUT_SECONDS=30
OPENLIGADB_MAX_ATTEMPTS=3
OPENLIGADB_RETRY_BASE_DELAY_SECONDS=1
OPENLIGADB_RETRY_MAX_DELAY_SECONDS=30
OPENLIGADB_MINIMUM_REQUEST_INTERVAL_SECONDS=1

# API-Football v3 provider transport
# When enabled, each successful scheduled import is followed by Outlook sync
# Keep the provider disabled until the manual live-validation prerequisites
# in docs/phase-4-live-validation.md have been completed.
API_FOOTBALL_ENABLED=false
API_FOOTBALL_API_KEY=your-api-football-key
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_CONNECT_TIMEOUT_SECONDS=5
API_FOOTBALL_READ_TIMEOUT_SECONDS=30
API_FOOTBALL_MAX_ATTEMPTS=3
API_FOOTBALL_RETRY_BASE_DELAY_SECONDS=1
API_FOOTBALL_RETRY_MAX_DELAY_SECONDS=30
# Legacy provider interval; SOURCE_JOBS_JSON.interval_seconds is authoritative.
API_FOOTBALL_IMPORT_INTERVAL_SECONDS=3600
