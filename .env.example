# Application
TZ=Europe/Vienna
DATABASE_PATH=/data/sports.db
LOG_LEVEL=INFO
HEARTBEAT_INTERVAL=300

# Microsoft 365 application
M365_TENANT_ID=your-tenant-id
M365_CLIENT_ID=your-client-id
